generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTICIPANT
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  @@map("categories")
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  email         String       @unique
  password_hash String
  role          Role         @default(PARTICIPANT)
  event_id      String?
  created_at    DateTime     @default(now())
  
  event         Event?       @relation(fields: [event_id], references: [id])
  team_member   TeamMember?
  submissions   Submission[]
  created_chals Challenge[]  @relation("CreatedChallenges")
  used_tokens   EventToken[] @relation("UsedTokens")
  writeups      Writeup[]

  @@map("users")
}

model Team {
  id            String       @id @default(uuid())
  name          String       @unique
  invite_code   String       @unique
  leader_id     String
  score         Int          @default(0)
  writeup_score Int          @default(0)
  color         String       @default("#00F0FF")
  is_banned     Boolean      @default(false)
  event_id      String
  created_at    DateTime     @default(now())

  event         Event        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  members       TeamMember[]
  submissions   Submission[]
  first_bloods  FirstBlood[]
  writeups      Writeup[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  team_id   String
  user_id   String   @unique
  joined_at DateTime @default(now())

  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_members")
}

model Challenge {
  id          String       @id @default(uuid())
  title       String
  description String       @db.Text
  category    String
  points      Int          @default(100)
  flag        String?      @db.Text
  flag_hash   String       // SHA256 hashed flag
  hint        String?      @db.Text
  hint_cost   Int          @default(0)
  file_url    String?      // Optional attachment URL/path
  is_active   Boolean      @default(true)
  created_by  String?
  event_id    String
  created_at  DateTime     @default(now())

  event       Event        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  creator     User?        @relation("CreatedChallenges", fields: [created_by], references: [id], onDelete: SetNull)
  submissions Submission[]
  first_blood FirstBlood?

  @@map("challenges")
}

model Submission {
  id           String    @id @default(uuid())
  team_id      String
  user_id      String
  challenge_id String
  is_correct   Boolean   @default(false)
  submitted_at DateTime  @default(now())

  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@index([team_id, challenge_id])
  @@map("submissions")
}

model FirstBlood {
  id           String    @id @default(uuid())
  challenge_id String    @unique
  team_id      String
  achieved_at  DateTime  @default(now())

  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("first_bloods")
}

model Event {
  id                 String        @id @default(uuid())
  name               String        @unique
  join_token         String        @unique
  participation_mode String        @default("TEAM") // "TEAM" | "INDIVIDUAL" | "HYBRID"
  min_team_size      Int           @default(1)
  max_team_size      Int           @default(5)

  start_time         DateTime?
  end_time           DateTime?
  freeze_time        DateTime?
  is_frozen          Boolean       @default(false)
  is_active          Boolean       @default(true)
  is_chained         Boolean       @default(false)
  created_at         DateTime      @default(now())

  users              User[]
  teams              Team[]
  challenges         Challenge[]
  event_tokens       EventToken[]
  writeups           Writeup[]

  @@map("events")
}

model EventToken {
  id              String    @id @default(uuid())
  token           String    @unique
  event_id        String
  label           String?
  is_used         Boolean   @default(false)
  used_by_user_id String?
  used_at         DateTime?
  created_at      DateTime  @default(now())

  event           Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  used_by_user    User?     @relation("UsedTokens", fields: [used_by_user_id], references: [id], onDelete: SetNull)

  @@index([event_id])
  @@map("event_tokens")
}

model Writeup {
  id           String    @id @default(uuid())
  team_id      String
  user_id      String
  event_id     String
  file_url     String
  file_name    String
  file_size    Int       @default(0)
  notes        String?   @db.Text
  score        Int       @default(0) // Skor/Nilai dari Juri
  feedback     String?   @db.Text    // Feedback/Catatan dari Juri
  evaluated_by String?   // Username atau ID Juri
  evaluated_at DateTime?
  submitted_at DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event        Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([team_id, event_id])
  @@map("writeups")
}

