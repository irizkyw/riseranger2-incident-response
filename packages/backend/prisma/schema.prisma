generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CustomRole {
  id           String   @id @default(uuid())
  name         String   @unique
  display_name String
  description  String?  @db.Text
  badge_color  String?  @default("text-cyan-400 bg-cyan-500/10 border-cyan-500/30")
  permissions  Json?
  is_system    Boolean  @default(false)
  created_at   DateTime @default(now())

  @@map("custom_roles")
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  @@map("categories")
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  email         String       @unique
  password_hash String
  role              String       @default("PARTICIPANT")
  event_id          String?
  active_session_id String?      @db.VarChar(128)
  last_ip           String?      @db.VarChar(64)
  last_login_at     DateTime?
  created_at        DateTime     @default(now())
  
  event         Event?       @relation(fields: [event_id], references: [id])
  team_member   TeamMember?
  submissions   Submission[]
  created_chals Challenge[]  @relation("CreatedChallenges")
  used_tokens   EventToken[] @relation("UsedTokens")
  writeups      Writeup[]
  team_histories UserTeamHistory[]
  challenge_attempts ChallengeAttempt[]
  unlocked_hints UnlockedHint[]

  @@map("users")
}

model Team {
  id            String       @id @default(uuid())
  name          String       @unique
  invite_code   String       @unique
  leader_id     String
  score         Int          @default(0)
  writeup_score Int          @default(0)
  color         String       @default("#00F0FF")
  is_banned     Boolean      @default(false)
  is_paused     Boolean      @default(false)
  is_force_stopped Boolean   @default(false)
  event_id      String
  created_at    DateTime     @default(now())

  event         Event        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  members       TeamMember[]
  submissions   Submission[]
  first_bloods  FirstBlood[]
  writeups      Writeup[]
  unlocked_hints UnlockedHint[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  team_id   String
  user_id   String   @unique
  joined_at DateTime @default(now())

  team      Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([team_id, user_id])
  @@map("team_members")
}

model Challenge {
  id          String       @id @default(uuid())
  title       String
  description String       @db.Text
  category    String
  points      Int          @default(100)
  flag        String?      @db.Text
  flag_hash   String       // SHA256 hashed flag
  hint        String?      @db.Text
  hint_cost   Int          @default(0)
  file_url    String?      // Optional attachment URL/path
  is_active   Boolean      @default(true)
  is_hidden   Boolean      @default(false) // Toggle visibility for participants (hidden/shown)
  unlock_order Int         @default(0) // Step sequence in Chaining mode (1, 2, 3, ...)
  // Per-challenge First Blood bonus override (overrides event-level bonus if enabled)
  fb_bonus_override       Boolean @default(false) // If true, use per-challenge bonus values
  fb_bonus_override_1st   Int     @default(50)    // Custom 1st Blood bonus for this challenge
  fb_bonus_override_2nd   Int     @default(25)    // Custom 2nd Blood bonus for this challenge
  fb_bonus_override_3rd   Int     @default(10)    // Custom 3rd Blood bonus for this challenge
  created_by  String?
  event_id    String
  created_at  DateTime     @default(now())

  event       Event        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  creator     User?        @relation("CreatedChallenges", fields: [created_by], references: [id], onDelete: SetNull)
  submissions Submission[]
  first_blood FirstBlood?
  challenge_attempts ChallengeAttempt[]
  unlocked_hints UnlockedHint[]

  @@map("challenges")
}


model UnlockedHint {
  id            String    @id @default(uuid())
  team_id       String
  user_id       String
  challenge_id  String
  event_id      String?
  cost_deducted Int       @default(0)
  unlocked_at   DateTime  @default(now())

  team          Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge     Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@unique([team_id, challenge_id])
  @@index([user_id])
  @@index([team_id])
  @@index([challenge_id])
  @@map("unlocked_hints")
}

model Submission {
  id           String    @id @default(uuid())
  team_id      String
  user_id      String
  challenge_id String
  flag         String?
  ip           String?
  is_correct   Boolean   @default(false)
  submitted_at DateTime  @default(now())

  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@index([team_id, challenge_id])
  @@map("submissions")
}

model FirstBlood {
  id           String    @id @default(uuid())
  challenge_id String    @unique
  team_id      String
  achieved_at  DateTime  @default(now())

  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@map("first_bloods")
}

model Event {
  id                 String        @id @default(uuid())
  name               String        @unique
  join_token         String        @unique
  participation_mode String        @default("TEAM") // "TEAM" | "INDIVIDUAL" | "HYBRID"
  min_team_size      Int           @default(1)
  max_team_size      Int           @default(5)

  start_time         DateTime?
  end_time           DateTime?
  freeze_time        DateTime?
  is_frozen          Boolean       @default(false)
  is_active          Boolean       @default(true)
  is_paused          Boolean       @default(false)
  paused_at          DateTime?
  is_finished        Boolean       @default(false)
  finished_at        DateTime?
  is_chained         Boolean       @default(false)
  enable_fb_bonus    Boolean       @default(true)
  fb_bonus_1st       Int           @default(50)
  fb_bonus_2nd       Int           @default(25)
  fb_bonus_3rd       Int           @default(10)
  solve_decay_pts    Int           @default(5)
  created_at         DateTime      @default(now())

  users              User[]
  teams              Team[]
  challenges         Challenge[]
  event_tokens       EventToken[]
  writeups           Writeup[]

  @@map("events")
}

model EventToken {
  id              String    @id @default(uuid())
  token           String    @unique
  event_id        String
  label           String?
  is_used         Boolean   @default(false)
  used_by_user_id String?
  used_at         DateTime?
  created_at      DateTime  @default(now())

  event           Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  used_by_user    User?     @relation("UsedTokens", fields: [used_by_user_id], references: [id], onDelete: SetNull)

  @@index([event_id])
  @@map("event_tokens")
}

model Writeup {
  id           String    @id @default(uuid())
  team_id      String
  user_id      String
  event_id     String
  file_url     String
  file_name    String
  file_size    Int       @default(0)
  notes        String?   @db.Text
  score        Int       @default(0) // Skor/Nilai dari Juri
  feedback     String?   @db.Text    // Feedback/Catatan dari Juri
  evaluated_by String?   // Username atau ID Juri
  evaluated_at DateTime?
  submitted_at DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  team         Team      @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event        Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@unique([team_id, event_id])
  @@map("writeups")
}

model UserTeamHistory {
  id          String   @id @default(uuid())
  user_id     String
  team_name   String
  invite_code String?
  role        String   @default("MEMBER") // "LEADER" or "MEMBER"
  event_name  String?
  action      String   @default("CREATED") // "CREATED", "JOINED", "LEFT", "DISBANDED", "KICKED"
  color       String   @default("#00F0FF")
  score       Int      @default(0)
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_team_histories")
}

model ChallengeAttempt {
  id                     String    @id @default(uuid())
  user_id                String
  team_id                String?
  challenge_id           String
  event_id               String?
  status                 String    @default("IN_PROGRESS") // "IN_PROGRESS" | "IDLE" | "SOLVED" | "PAUSED" | "FORCE_STOPPED"
  is_force_stopped       Boolean   @default(false)
  is_paused              Boolean   @default(false)
  paused_duration_seconds Int      @default(0)
  paused_at              DateTime?
  started_at             DateTime  @default(now())
  last_active_at         DateTime  @default(now())
  solved_at              DateTime?

  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  challenge              Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)

  @@unique([user_id, challenge_id])
  @@index([user_id])
  @@index([team_id])
  @@index([challenge_id])
  @@index([event_id])
  @@index([status])
  @@map("challenge_attempts")
}

